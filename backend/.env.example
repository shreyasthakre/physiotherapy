# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173

# ─── Database ─────────────────────────────────────────────
# DB_DRIVER selects the storage engine:
#   pg     → external PostgreSQL server (configure DATABASE_URL / PG* below)
#   pglite → embedded, in-process Postgres (WASM). Zero setup: no server to
#            install. Data persists to PGLITE_DIR. Great for local dev.
DB_DRIVER=pglite
# Folder where the embedded PGlite database is stored (relative to backend/).
PGLITE_DIR=.pgdata

# Used only when DB_DRIVER=pg.
# Either provide a full connection string...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/physiotherapy
# ...or the individual parts (used only if DATABASE_URL is empty)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=physiotherapy
# Set to true when connecting to a managed DB that requires SSL
PGSSL=false

# ─── AWS / production (when the API also serves the website) ──
# Build the frontend once (`npm run build`) so Express can serve frontend/dist.
# Health check path for load balancers: GET /health
# CORS_ORIGIN should be the public HTTPS URL of this same service, e.g.
#   CORS_ORIGIN=https://your-app.ap-south-1.awsapprunner.com
# For Amazon RDS, set DB_DRIVER=pg, DATABASE_URL from RDS, and PGSSL=true.

# ─── Auth (JWT) ───────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Email / SMS reminders ────────────────────────────────
# SMTP is used for appointment confirmation, update + reminder emails.
# Behaviour when SMTP_HOST is blank:
#   • development → a free Ethereal test inbox is used automatically and a
#     preview URL for each email is printed to the server console.
#   • production  → emails are only logged (not sent).
# For REAL delivery, fill these in. Example (Gmail with an App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
# Other easy options: Brevo, SendGrid, Mailgun, Mailtrap (for testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Physiotherapy Clinic <no-reply@physiotherapyclinic.example>"
# Set EMAIL_PREVIEW=true (dev only, no SMTP_HOST) to auto-create an Ethereal
# test inbox and print a preview URL per email. Requires outbound SMTP (587)
# to be open on your network. When email is not enabled, appointment
# notifications simply use WhatsApp + SMS and the in-app log.
EMAIL_PREVIEW=false

# ─── SMS / WhatsApp / Voice calls (Twilio) ────────────────
# Twilio uses HTTPS (port 443), so it works even when SMTP is blocked.
# Fill these to send REAL SMS, WhatsApp messages and automated voice calls.
# Leave blank to run in demo mode (messages/calls are just logged).
#   Find SID + token at https://console.twilio.com
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
# SMS sender (a Twilio phone number in E.164 format, e.g. +12025550123)
SMS_FROM=
# WhatsApp sender number (Twilio sandbox default is +14155238886). No prefix.
TWILIO_WHATSAPP_FROM=
# Voice caller ID for automated calls (defaults to SMS_FROM if blank)
TWILIO_CALL_FROM=

# ─── Newsletter (Mailchimp) ───────────────────────────────
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_LIST_ID=

# ─── Seed admin account ───────────────────────────────────
SEED_ADMIN_EMAIL=admin@physioclinic.example
SEED_ADMIN_PASSWORD=Admin@12345
