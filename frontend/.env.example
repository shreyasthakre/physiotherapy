# Base URL for the backend API. In dev the Vite proxy forwards /api to the
# backend, so you can leave this as the default relative path.
VITE_API_BASE_URL=/api

# Where the dev proxy forwards /api requests (backend server).
VITE_API_PROXY_TARGET=http://localhost:4000

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable.
VITE_GA_MEASUREMENT_ID=

# Public site URL used for SEO canonical + structured data.
VITE_SITE_URL=http://localhost:5173
